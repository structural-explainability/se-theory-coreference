cff-version: "1.2.0"
message: "If you use this work, please cite it using the metadata in CITATION.cff."
type: software

title: "SE Theory: Coreference"
version: "0.1.0"
date-released: "2026-10-18"

authors:
  - family-names: Case
    given-names: Denise M.
    orcid: "https://orcid.org/0000-0001-6165-7389"
    affiliation: "Northwest Missouri State University, School of Computer Science and Information Systems, Maryville, MO, USA"

repository-code: "https://github.com/structural-explainability/se-theory-coreference"
url: "https://github.com/structural-explainability/se-theory-coreference"

license: MIT

abstract: >
  Lean 4 formalization of foundational coreference theory for
  Structural Explainability. This repository defines context-indexed
  co-reference judgments, the identity relation those judgments generate,
  and the distinct-commitments kept separate from them. It builds on the
  Structural Explainability Neutral Substrate, Persistence, and
  Individuation theories.

keywords:
  - structural-explainability
  - coreference-theory
  - co-reference
  - identity-commitments
  - generated-identity
  - lean4
  - theorem-proving
  - formal-verification
